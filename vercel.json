{
  "rewrites": [
    { "source": "/((?!api/.*).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/tdx/sync",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cctv/cross-validation/step",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cctv/cross-validation/analyze",
      "schedule": "*/5 * * * *"
    }
  ]
}
